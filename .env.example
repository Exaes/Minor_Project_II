# ──────────────────────────────────────────────
# Copy this file to .env and fill in values
# ──────────────────────────────────────────────

# Hugging Face API token (optional — fallback recommendations work without it)
HF_API_TOKEN=

# LLM model to use via HF Inference API
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Database URL (default: SQLite in project root)
DATABASE_URL=sqlite:///./startup_analysis.db

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit
STREAMLIT_PORT=8501
